# Copy to .env and .env.local, then restart: npm run dev
#
# Vite proxies /api, /auth, /socket.io to this URL (same-origin — no CORS in dev).
# Variable name MUST be VITE_API_TARGET (vite.config.ts).

# APIM gateway (team target)
VITE_API_TARGET=https://apim.noltfinance.com/api/nms

# Fallback if APIM auth is not live yet:
# VITE_API_TARGET=https://nolt-admin-backend-production-7761.up.railway.app

# Optional
# GEMINI_API_KEY=
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
