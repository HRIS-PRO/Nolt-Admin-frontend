# Copy to .env and .env.local, then restart: npm run dev
#
# Vite proxies /api, /auth, /socket.io to this URL (same-origin — no CORS in dev).

VITE_API_TARGET=https://apim.noltfinance.com/api/admin
VITE_BACKEND_URL=https://apim.noltfinance.com/api/admin
VITE_API_URL=https://apim.noltfinance.com/api/admin

# Optional
# GEMINI_API_KEY=
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
