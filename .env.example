# ── Local dev (recommended) ─────────────────────────────────────────────
# Copy .env.development values, or run: npm run dev (loads .env.development)
#
# VITE_USE_LOCAL_PROXY=true   → browser uses /api and /auth (Vite proxy, no CORS)
# VITE_API_TARGET=http://localhost:5000   → proxy target only (not sent to browser)
# Leave VITE_BACKEND_URL and VITE_API_URL empty for local proxy mode.
#
# Backend (Nolt-Admin-backend/.env):
#   PORT=5000
#   FRONTEND_URL=http://localhost:3000
#   GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
#
# Start backend:  cd Nolt-Admin-backend && npm run dev
# Start frontend: cd Nolt-Admin-frontend && npm run dev

VITE_USE_LOCAL_PROXY=true
VITE_API_TARGET=http://localhost:5000
VITE_BACKEND_URL=
VITE_API_URL=

# ── Production (Amplify / Vercel) ───────────────────────────────────────
# Same-origin proxy: hosting redirects /api and /auth → APIM gateway.
# Copy .env.production or set in Amplify Console:
#   VITE_USE_LOCAL_PROXY=true
#   VITE_BACKEND_URL=   (leave empty)
#   VITE_API_URL=       (leave empty)
#
# APIM backend: https://apim.noltfinance.com/api/admin
#
# Amplify uses amplify.yml (not vercel.json). Keep CSP in sync with
# constants/contentSecurityPolicy.ts.

# VITE_USE_LOCAL_PROXY=true
# VITE_BACKEND_URL=
# VITE_API_URL=

# Direct APIM mode (only if you skip hosting proxy and rely on CORS):
# VITE_USE_LOCAL_PROXY=false
# VITE_BACKEND_URL=https://apim.noltfinance.com/api/admin
# VITE_API_URL=https://apim.noltfinance.com/api/admin

# Optional
# GEMINI_API_KEY=
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
